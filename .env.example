APP_ENV=development
POSTGRES_DB=shaha_finlease
POSTGRES_USER=shaha_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
SQLSERVER_PORT=1433
SQLSERVER_SA_PASSWORD=ReplaceWithALocalStrongPassword1!
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
# Local backend: host localhost. In Compose use postgresql://shaha_app:...@db:5432/shaha_finlease
DATABASE_URL=postgresql+psycopg://shaha_app:replace-with-a-local-password@localhost:5432/shaha_finlease
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Generate a password hash locally; never put a plaintext password here.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=5
VERIFICATION_RATE_LIMIT_PER_MINUTE=10
SECURITY_RATE_WINDOW_SECONDS=60
OUTBOUND_CALLING_ENABLED=false
CALLING_TIMEZONE=Asia/Kolkata
CALLING_HOUR_START=8
CALLING_HOUR_END=19
TRANSCRIPT_RETENTION_DAYS=180
# Optional small-talk model. Disabled unless explicitly opted in and a key is supplied.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Twilio Conversation Relay stays disabled until all three settings are supplied.
# Use the HTTPS origin for signature reconstruction; TwiML will derive wss:// for the relay socket.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=

